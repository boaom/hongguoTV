<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#FF3B30</item>
        <item name="android:windowBackground">#03060F</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/TvDialogTheme</item>
    </style>
    <style name="TvDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF3B30</item>
        <item name="android:windowBackground">@drawable/tv_dialog_surface</item>
        <item name="android:textColorPrimary">#EDF3FF</item>
        <item name="android:textColorSecondary">#9FB3E8</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>